{
  "version": 1,
  "sdk_version": "3.3.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://qlwtccmvddhgdnknrgnh.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "bridgelib",
      "version": "0.1.0",
      "title": "BridgeLIB"
    },
    "tools": [
      {
        "name": "list_subjects",
        "title": "List subjects",
        "description": "List BridgeLIB course subjects the signed-in user can see.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_lessons",
        "title": "List lessons",
        "description": "List published lessons for one subject, including whether the user has completed each.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "subject_id": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "Subject ID from list_subjects."
            }
          },
          "required": [
            "subject_id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "my_progress",
        "title": "My learning progress",
        "description": "Show the signed-in user's enrolled courses, completed lesson count and recent exam attempts.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "complete_lesson",
        "title": "Mark lesson complete",
        "description": "Mark a published lesson as completed for the signed-in user.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": true,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "lesson_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Lesson ID from list_lessons."
            }
          },
          "required": [
            "lesson_id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
